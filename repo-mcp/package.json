{
  "name": "physicalrisk-repo-mcp",
  "version": "1.16.0",
  "private": true,
  "description": "Standalone MCP proxy for Physical Risk Repository — calls repo-api only",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.spec.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
