  checkedBy    User? @relation("QaChecker", fields: [checkedById], references: [id])
  @@unique([assessmentId, code])
}

model ActionItem {
  id                 String          @id @default(cuid())
  reference          String
  assessmentId       String
  organisationId     String
  findingId          String?
  recommendationId   String?
  title              String
  description        String?
  ownerUserId        String?
  ownerName          String?
  department         String?
