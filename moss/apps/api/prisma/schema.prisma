/// Immutable snapshot when an EAD is completed and Level 3 routing is confirmed.
model AdvisoryDiagnosticOutcome {
  id                    String         @id @default(cuid())
  assessmentId          String         @unique
  confirmedAt           DateTime
  confirmedById         String
  commercialReference   String?        @unique
  commercialStatus      ProposalStatus @default(NOT_REQUESTED)
  commercialRequestedAt DateTime?
  commercialSentAt      DateTime?
