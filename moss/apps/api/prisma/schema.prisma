generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SUPER_ADMIN = system admin; REVIEWER = senior reviewer; SALES = sales user (kept for MVP compatibility)
enum SystemRole {
  SUPER_ADMIN
  METHODOLOGY_ADMIN
  ANALYST
  REVIEWER
  SALES
  CLIENT_EXECUTIVE
  CLIENT_CONTRIBUTOR
  AUDITOR
}

enum QuestionnaireStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ValueType {
  TEXT
  NUMBER
  CURRENCY
  PERCENT
  BOOLEAN
  SELECT
  DATE
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  AWAITING_CONTRIBUTOR
  SUBMITTED
  REVIEWED
  /// Legacy pilot statuses retained for existing rows; Lean MVP uses DRAFT→…→REPORT_ISSUED.
  AUTOMATED_EVALUATION_COMPLETE
  EVIDENCE_REVIEW
  ANALYST_REVIEW
  QUALITY_ASSURANCE
  APPROVED
  REPORT_GENERATED
  REPORT_ISSUED
  REMEDIATION_IN_PROGRESS
  REASSESSMENT_DUE
  CLOSED
  ARCHIVED
}

enum EvidenceStatus {
  SUBMITTED
  PENDING
  UNDER_REVIEW
  ACCEPTED
  VERIFIED
  PARTIALLY_VERIFIED
  REJECTED
  OUTDATED
  MISSING
  MISSING_INFORMATION
  NOT_APPLICABLE
}

enum FindingSeverity {
  INFORMATIONAL
  LOW
  MEDIUM
  MODERATE
  HIGH
  CRITICAL
}

enum FindingStatus {
  DRAFT
  UNDER_REVIEW
  CONFIRMED
  DISPUTED
  ACCEPTED
  REMEDIATION_IN_PROGRESS
  RESOLVED
  CLOSED
}

enum RecommendationStatus {
  GENERATED
  PROPOSED
  ACCEPTED
  REJECTED
  PLANNED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  DISMISSED
}

enum ReportStatus {
  DRAFT
  GENERATED
  APPROVED
  ISSUED
  SUPERSEDED
}

enum ReportType {
  PRELIMINARY_EXECUTIVE
  EXECUTIVE_ADVISORY_BRIEF
  FOCUSED_ASSURANCE_REPORT
  COMMITTEE_ASSURANCE_REPORT
  VERIFIED_EXECUTIVE
  ANALYST_WORKING_PAPER
  EVIDENCE_REGISTER
  FINDINGS_REPORT
  REMEDIATION_ACTION_PLAN
  REASSESSMENT_COMPARISON
}

enum SyncStatus {
  PENDING
  PROCESSING
  SUCCESS
  SYNCED
  FAILED
  RETRYING
  SKIPPED
  CANCELLED
}

enum AssignmentRole {
  PRIMARY_ANALYST
  SENIOR_REVIEWER
  CONTRIBUTOR
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OverrideStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum QaItemStatus {
  PENDING
  PASSED
  FAILED
  NOT_APPLICABLE
}

enum ActionItemStatus {
  NOT_STARTED
  PLANNED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  VERIFIED
  CANCELLED
}

enum EmailJobStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum AssumptionRecordStatus {
  ACTIVE
  INACTIVE
  SUPERSEDED
}

/// Product discriminator for AssessmentSession. SOMOD is intentionally omitted — do not attach SOMOD behaviour here.
enum ProductCode {
  EXECUTIVE_GOVERNANCE_TRIAGE
  SCLI_COST_LEAKAGE
  EXECUTIVE_ADVISORY_DIAGNOSTIC
  CONTRACT_SLA_ASSURANCE
  VENDOR_PERFORMANCE_ASSURANCE
  GOVERNANCE_EXECUTIVE_ASSURANCE
  CYBER_PHYSICAL_DEPENDENCY
  SHIELD360
  MOSS
}

/// Commercial proposal workflow for Level 1 Executive Governance Triage leads.
enum ProposalStatus {
  NOT_REQUESTED
  REQUESTED
  IN_PREPARATION
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum AdvisoryRoutePriority {
  HIGH
  RECOMMENDED
  OPTIONAL
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

enum MossCatalogueStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MossControlAssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  SCORED
  NEEDS_EVIDENCE
  COMPLETE
}

enum MossScoringConfigStatus {
  DRAFT
  PUBLISHED
}

enum MossAggregationMode {
  MEAN
  WEIGHTED_MEAN
  MIN
  UNCONFIGURED
}

/// SOMOD uses a dedicated aggregate — not AssessmentSession / ProductCode.
enum SomodAssessmentStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  RETURNED_FOR_CORRECTION
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum SomodScenarioType {
  CURRENT
  RISK_ALIGNED
  COST_EFFICIENT
  RECOMMENDED_OPTIMAL
}

enum SomodScenarioStatus {
  DRAFT
  READY
  SELECTED
}

/// Financial layer approval (handoff §10) — separate from assessment workflow status.
enum SomodFinancialLayerStatus {
  DRAFT
  CALCULATED
  IN_REVIEW
  RETURNED
  APPROVED
  LOCKED
}

enum MossRecommendationSource {
  MANUAL
  CATALOGUE_TEMPLATE
  RULE_ENGINE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  systemRole   SystemRole   @default(CLIENT_CONTRIBUTOR)
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  createdAssessments AssessmentSession[] @relation("AssessmentCreator")
  reviewedAssessments AssessmentSession[] @relation("AssessmentReviewer")
  approvedAssessments AssessmentSession[] @relation("AssessmentApprover")
  unlockedAssessments AssessmentSession[] @relation("AssessmentUnlocker")
  generatedReports Report[] @relation("ReportGenerator")
  assignmentsMade AssessmentAssignment[] @relation("AssignmentAssigner")
  assignmentsHeld AssessmentAssignment[] @relation("AssignmentAssignee")
  evidenceReviewed EvidenceDocument[] @relation("EvidenceReviewer")
  findingsOwned Finding[] @relation("FindingAnalyst")
  findingsReviewed Finding[] @relation("FindingReviewer")
  overridesRequested ScoreOverride[] @relation("OverrideRequester")
  overridesDecided ScoreOverride[] @relation("OverrideDecider")
  qaChecks QaChecklistItem[] @relation("QaChecker")
  actionItemsOwned ActionItem[] @relation("ActionOwner")
  actionItemsVerified ActionItem[] @relation("ActionVerifier")
  assumptionsApproved CalibrationAssumption[] @relation("AssumptionApprover")
  mossControlAssessments MossControlAssessment[] @relation("MossControlAssessor")
  mossRecommendations Recommendation[] @relation("MossRecommendationAuthor")
  somodAssessmentsCreated SomodAssessment[] @relation("SomodAssessmentCreator")
  somodFinancialApprovals SomodAssessment[] @relation("SomodFinancialApprover")
  assignedTriageLeads PublicLead[] @relation("TriageAssignedAnalyst")
  advisoryOutcomesConfirmed AdvisoryDiagnosticOutcome[] @relation("AdvisoryOutcomeConfirmer")
  auditEvents  AuditEvent[]
}

model Organisation {
  id               String       @id @default(cuid())
  name             String
  industry         String?
  registrationNo   String?
  website          String?
  primaryEmail     String?
  primaryPhone     String?
  espocrmAccountId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  memberships      Membership[]
  sites            Site[]
  assessments      AssessmentSession[]
  somodAssessments SomodAssessment[]
  crmSyncRecords   CrmSyncRecord[]
  actionItems      ActionItem[]
}

/// Shared site master data in the diagnostic platform DB (not Repository).
model Site {
  id             String     @id @default(cuid())
  organisationId String
  name           String
  siteCode       String
  address        String?
  region         String?
  description    String?
  status         SiteStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  assessments    AssessmentSession[]
  somodAssessments SomodAssessment[]
  @@unique([organisationId, siteCode])
  @@index([organisationId, status])
}

model Membership {
  id             String     @id @default(cuid())
  userId         String
  organisationId String
  role           SystemRole
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  @@unique([userId, organisationId])
}

model Questionnaire {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    QuestionnaireVersion[]
}

model QuestionnaireVersion {
  id              String              @id @default(cuid())
  questionnaireId String
  version         String
  status          QuestionnaireStatus @default(DRAFT)
  methodologyNote String?
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  questionnaire   Questionnaire       @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  inputDefinitions AssessmentInputDefinition[]
  questions       Question[]
  assumptions     CalibrationAssumption[]
  recommendationRules RecommendationRule[]
  assessments     AssessmentSession[]
  @@unique([questionnaireId, version])
}

model AssessmentInputDefinition {
  id                     String   @id @default(cuid())
  questionnaireVersionId String
  code                   String
  label                  String
  guidance               String?
  valueType              ValueType
  unit                   String?
  required               Boolean  @default(true)
  options                Json?
  sortOrder              Int
  defaultValue           Json?
  questionnaireVersion   QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id], onDelete: Cascade)
  values                 AssessmentInputValue[]
  evidence               EvidenceDocument[]
  @@unique([questionnaireVersionId, code])
}

model Question {
  id                     String   @id @default(cuid())
  questionnaireVersionId String
  code                   String
  category               String
  text                   String
  guidance               String?
  evidenceHint           String?
  weight                 Decimal  @db.Decimal(8, 2)
  required               Boolean  @default(true)
  sortOrder              Int
  questionnaireVersion   QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id], onDelete: Cascade)
  options                ResponseOption[]
  responses              AssessmentResponse[]
  recommendationRules    RecommendationRule[]
  evidence               EvidenceDocument[]
  @@unique([questionnaireVersionId, code])
}

model ResponseOption {
  id         String   @id @default(cuid())
  questionId String
  label      String
  riskScore  Decimal  @db.Decimal(8, 2)
  sortOrder  Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses  AssessmentResponse[]
  @@unique([questionId, label])
}

model CalibrationAssumption {
  id                     String  @id @default(cuid())
  questionnaireVersionId String
  code                   String
  label                  String
  value                  Decimal @db.Decimal(18, 8)
  format                 String
  description            String?
  dataType               String  @default("NUMBER")
  unit                   String?
  minValue               Decimal? @db.Decimal(18, 8)
  maxValue               Decimal? @db.Decimal(18, 8)
  formulaUsage           String?
  effectiveFrom          DateTime?
  expiresAt              DateTime?
  status                 AssumptionRecordStatus @default(ACTIVE)
  changeReason           String?
  approvedById           String?
  previousVersionId      String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt
  questionnaireVersion   QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id], onDelete: Cascade)
  approvedBy             User? @relation("AssumptionApprover", fields: [approvedById], references: [id])
  previousVersion        CalibrationAssumption? @relation("AssumptionVersions", fields: [previousVersionId], references: [id])
  nextVersions           CalibrationAssumption[] @relation("AssumptionVersions")
  @@unique([questionnaireVersionId, code])
  @@index([code, status])
}

model AssessmentSession {
  id                     String           @id @default(cuid())
  reference              String           @unique
  organisationId         String
  questionnaireVersionId String
  /// Product discriminator. Existing/historical rows backfilled to SCLI_COST_LEAKAGE.
  /// REQUIREMENT (M3/M8): legacy SCLI list/get APIs must filter productCode = SCLI_COST_LEAKAGE
  /// so future MOSS sessions are never exposed on Cost Leakage endpoints.
  productCode            ProductCode      @default(SCLI_COST_LEAKAGE)
  siteId                 String?
  mossCatalogueVersionId String?
  createdById            String
  title                  String
  status                 AssessmentStatus @default(DRAFT)
  executiveUrgency       Int              @default(50)
  engagementReadiness    Int              @default(50)
  submittedAt            DateTime?
  reviewedAt             DateTime?
  reviewedById           String?
  reviewNote             String?
  approvedAt             DateTime?
  approvedById           String?
  lockedAt               DateTime?
  unlockedAt             DateTime?
  unlockedById           String?
  unlockReason           String?
  returnReason           String?
  parentAssessmentId     String?
  espocrmOpportunityId   String?
  espocrmTaskId          String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  organisation           Organisation     @relation(fields: [organisationId], references: [id])
  questionnaireVersion   QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id])
  site                   Site?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  mossCatalogueVersion   MossCatalogueVersion? @relation(fields: [mossCatalogueVersionId], references: [id], onDelete: SetNull)
  createdBy              User             @relation("AssessmentCreator", fields: [createdById], references: [id])
  reviewedBy             User?            @relation("AssessmentReviewer", fields: [reviewedById], references: [id])
  approvedBy             User?            @relation("AssessmentApprover", fields: [approvedById], references: [id])
  unlockedBy             User?            @relation("AssessmentUnlocker", fields: [unlockedById], references: [id])
  parentAssessment       AssessmentSession? @relation("AssessmentReassessments", fields: [parentAssessmentId], references: [id])
  reassessments          AssessmentSession[] @relation("AssessmentReassessments")
  inputValues            AssessmentInputValue[]
  responses              AssessmentResponse[]
  scoreSnapshots         ScoreSnapshot[]
  mossControlAssessments MossControlAssessment[]
  mossScoreSnapshots     MossScoreSnapshot[]
  evidence               EvidenceDocument[]
  findings               Finding[]
  recommendations        Recommendation[]
  reports                Report[]
  advisoryModuleReviews  AdvisoryModuleReview[]
  diagnosticOutcome      AdvisoryDiagnosticOutcome?
  spawnedFromRoute       AdvisoryConfirmedRoute? @relation("RouteSpawnedAssessment")
  crmSyncRecords         CrmSyncRecord[]
  assignments            AssessmentAssignment[]
  scoreOverrides         ScoreOverride[]
  qaChecklist            QaChecklistItem[]
  actionItems            ActionItem[]
  somodLinkedAssessments SomodAssessment[] @relation("SomodMossLink")
  @@index([status])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([reference])
  @@index([productCode])
  @@index([productCode, organisationId])
  @@index([siteId])
  @@index([mossCatalogueVersionId])
}

model AssessmentAssignment {
  id             String           @id @default(cuid())
  assessmentId   String
  userId         String
  role           AssignmentRole
  assignedById   String
  assignedAt     DateTime         @default(now())
  dueDate        DateTime?
  completedAt    DateTime?
  status         AssignmentStatus @default(ASSIGNED)
  notes          String?
  assessment     AssessmentSession @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user           User             @relation("AssignmentAssignee", fields: [userId], references: [id])
  assignedBy     User             @relation("AssignmentAssigner", fields: [assignedById], references: [id])
  @@index([userId, status])
  @@index([assessmentId, role])
}

model AssessmentInputValue {
  id                String @id @default(cuid())
  assessmentId      String
  inputDefinitionId String
  value             Json
  updatedAt         DateTime @updatedAt
  assessment        AssessmentSession @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  inputDefinition   AssessmentInputDefinition @relation(fields: [inputDefinitionId], references: [id])
  @@unique([assessmentId, inputDefinitionId])
}

model AssessmentResponse {
  id               String @id @default(cuid())
  assessmentId     String
  questionId       String
  responseOptionId String?
  comment          String?
  analystOverrideRisk Decimal? @db.Decimal(8, 2)
  overrideReason   String?
  updatedAt        DateTime @updatedAt
  assessment       AssessmentSession @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question         Question @relation(fields: [questionId], references: [id])
  responseOption   ResponseOption? @relation(fields: [responseOptionId], references: [id])
  @@unique([assessmentId, questionId])
}

/// Immutable published catalogue versions intended; do not seed v3.0 in M1 (that is M2).
model MossCatalogueVersion {
  id          String              @id @default(cuid())
  version     String
  status      MossCatalogueStatus @default(DRAFT)
  title       String
  description String?
  notes       String?
  publishedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  domains     MossDomain[]
  controls    MossControl[]
  assessments AssessmentSession[]
  scoreSnapshots MossScoreSnapshot[]
  scoringConfigurations MossScoringConfiguration[]
  @@unique([version])
  @@index([status])
}

/// Versioned MOSS aggregation configuration.
/// Live methodology: MEAN v1.0.0 (unweighted) after client confirmation 2026-08-13.
model MossScoringConfiguration {
  id                     String                 @id @default(cuid())
  version                String
  status                 MossScoringConfigStatus @default(DRAFT)
  domainAggregation      MossAggregationMode    @default(UNCONFIGURED)
  overallAggregation     MossAggregationMode    @default(UNCONFIGURED)
  domainWeights          Json?
  criticalControlPolicy  Json?
  severityMapping        Json?
  recommendationPolicy   Json?
  notes                  String?
  /// Optional link to catalogue this config applies to.
  catalogueVersionId     String?
  publishedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  catalogueVersion       MossCatalogueVersion?  @relation(fields: [catalogueVersionId], references: [id], onDelete: SetNull)
  scoreSnapshots         MossScoreSnapshot[]
  @@unique([version])
  @@index([status])
  @@index([catalogueVersionId])
}

model MossDomain {
  id                 String              @id @default(cuid())
  catalogueVersionId String
  domainCode         String
  name               String
  sortOrder          Int
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  catalogueVersion   MossCatalogueVersion @relation(fields: [catalogueVersionId], references: [id], onDelete: Cascade)
  controls           MossControl[]
  @@unique([catalogueVersionId, domainCode])
  /// Enables composite FK so MossControl.domain belongs to the same catalogue version.
  @@unique([catalogueVersionId, id])
  @@index([catalogueVersionId, sortOrder])
}

model MossControl {
  id                 String              @id @default(cuid())
  catalogueVersionId String
  domainId           String
  controlCode        String
  name               String
  controlFunction    String?
  owner              String?
  frequency          String?
  metric             String?
  /// Maps catalogue `threshold` (text). Structured future form uses thresholdJson.
  thresholdText      String?
  thresholdJson      Json?
  sortOrder          Int                 @default(0)
  /// Methodology metadata (JSON arrays/objects preserved as-is from catalogue).
  evidenceStandards       Json?
  inspectionMethodology   Json?
  failureConditions       Json?
  fraudIndicators         Json?
  mossScoringRules        Json?
  /// Financial / optimisation metadata — store only; no MOSS calculation engine in M1.
  financialRelevance            String?
  eventUnit                     String?
  costCategory                  String?
  leakageQuantification         Json?
  /// Nullable for future use. Authoritative catalogue has no top-level formula_reference;
  /// M2 must map formula from leakage_quantification.formula — do not invent references.
  formulaReference              String?
  slaPenaltyLogic               Json?
  incidentToCostConversion      Json?
  technologySubstitutionLogic   String?
  manpowerOptimisationLogic     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  catalogueVersion   MossCatalogueVersion @relation(fields: [catalogueVersionId], references: [id], onDelete: Cascade)
  domain             MossDomain           @relation(fields: [catalogueVersionId, domainId], references: [catalogueVersionId, id], onDelete: Cascade)
  controlAssessments MossControlAssessment[]
  @@unique([catalogueVersionId, controlCode])
  @@index([domainId, sortOrder])
  @@index([catalogueVersionId, sortOrder])
}

model MossControlAssessment {
  id               String                     @id @default(cuid())
  assessmentId     String
  mossControlId    String
  controlCode      String
  score            Int?
  assessorScore    Int?
  scoreRationale   String?
  comment          String?
  findingText      String?
  status           MossControlAssessmentStatus @default(NOT_STARTED)
  assessedById     String?
  assessedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  /// Deferred to later milestone (M0 T6): suggestedScore, finalScore, scoreTrace
  assessment       AssessmentSession          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  mossControl      MossControl                @relation(fields: [mossControlId], references: [id], onDelete: Restrict)
  assessedBy       User?                      @relation("MossControlAssessor", fields: [assessedById], references: [id], onDelete: SetNull)
  evidence         EvidenceDocument[]
  findings         Finding[]
  @@unique([assessmentId, mossControlId])
  @@index([assessmentId, status])
  @@index([mossControlId])
}

/// MOSS-only score snapshot. Do not reuse SCLI ScoreSnapshot.
model MossScoreSnapshot {
  id                   String              @id @default(cuid())
  assessmentId         String
  catalogueVersionId   String
  configurationId      String?
  configurationVersion String?
  overallScore         Decimal?            @db.Decimal(8, 2)
  domainScores         Json
  controlScores        Json
  completenessPercent  Decimal             @db.Decimal(8, 4) @default(0)
  calculationTrace     Json?
  calculatedAt         DateTime            @default(now())
  createdAt            DateTime            @default(now())
  assessment           AssessmentSession   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  catalogueVersion     MossCatalogueVersion @relation(fields: [catalogueVersionId], references: [id], onDelete: Restrict)
  configuration        MossScoringConfiguration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  @@index([assessmentId, calculatedAt])
  @@index([catalogueVersionId])
  @@index([configurationId])
}

model ScoreSnapshot {
  id                 String   @id @default(cuid())
  assessmentId       String
  modelVersion       String
  overallRiskScore   Decimal  @db.Decimal(8, 2)
  maturityScore      Decimal  @db.Decimal(8, 2)
  riskBand           String
  methodologyConfidence Decimal @db.Decimal(8, 4)
  evidenceConfidence Decimal @db.Decimal(8, 4)
  opportunityScore   Decimal @db.Decimal(8, 2)
  categoryScores     Json
  leakageResult      Json
  calculationTrace   Json
  createdAt          DateTime @default(now())
  assessment         AssessmentSession @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model ScoreOverride {
  id                   String         @id @default(cuid())
  assessmentId         String
  originalScore        Decimal        @db.Decimal(8, 2)
  proposedScore        Decimal        @db.Decimal(8, 2)
  finalScore           Decimal?       @db.Decimal(8, 2)
  reason               String
  supportingEvidenceIds Json?
  requestedById        String
  requestedAt          DateTime       @default(now())
  decidedById          String?
  decidedAt            DateTime?
  reviewerComments     String?
  status               OverrideStatus @default(REQUESTED)
  assessment           AssessmentSession @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  requestedBy          User           @relation("OverrideRequester", fields: [requestedById], references: [id])
  decidedBy            User?          @relation("OverrideDecider", fields: [decidedById], references: [id])
  @@index([assessmentId, status])
}

model EvidenceDocument {
  id                 String         @id @default(cuid())
  assessmentId       String
  questionId         String?
  questionCode       String?
  inputDefinitionId  String?
  findingId          String?
  /// Additive MOSS link; existing SCLI rows remain null.
  mossControlAssessmentId String?
  title              String
  documentType       String?
  description        String?
  fileName           String
  mimeType           String
  sizeBytes          Int
  storageKey         String
  evidencePeriod     String?
  evidenceSource     String?
  uploadedById       String?
  status             EvidenceStatus @default(PENDING)
  reviewerId         String?
  reviewedAt         DateTime?
  reviewerNote       String?
  uploadedAt         DateTime       @default(now())
  assessment         AssessmentSession @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question           Question? @relation(fields: [questionId], references: [id])
  inputDefinition    AssessmentInputDefinition? @relation(fields: [inputDefinitionId], references: [id])
  finding            Finding? @relation(fields: [findingId], references: [id])
  mossControlAssessment MossControlAssessment? @relation(fields: [mossControlAssessmentId], references: [id], onDelete: SetNull)
  reviewer           User? @relation("EvidenceReviewer", fields: [reviewerId], references: [id])
  @@index([assessmentId, status])
  @@index([mossControlAssessmentId])
}

model Finding {
  id                   String          @id @default(cuid())
  assessmentId         String
  reference            String
  title                String
  category             String
  description          String
  relatedQuestionCodes Json?
  relatedEvidenceIds   Json?
  rootCause            String?
  riskImplication      String?
  governanceImplication String?
  financialImplication String?
  estimatedExposure    Decimal?        @db.Decimal(18, 2)
  /// Nullable for MOSS until client severity mapping is approved. SCLI continues to set a value.
  severity             FindingSeverity?
  likelihood           String?
  impact               String?
  priority             FindingSeverity?
  recommendationText   String?
  managementResponse   String?
  analystId            String?
  reviewerId           String?
  status               FindingStatus   @default(DRAFT)
  targetResolutionDate DateTime?
  financialImpact      Decimal?        @db.Decimal(18, 2)
  /// Additive product scope; existing SCLI findings remain null (treated as SCLI).
  productCode          ProductCode?
  /// Additive MOSS link; existing SCLI rows remain null.
  mossControlAssessmentId String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  assessment           AssessmentSession @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  analyst              User? @relation("FindingAnalyst", fields: [analystId], references: [id])
  reviewer             User? @relation("FindingReviewer", fields: [reviewerId], references: [id])
  mossControlAssessment MossControlAssessment? @relation(fields: [mossControlAssessmentId], references: [id], onDelete: SetNull)
  evidence             EvidenceDocument[]
  actionItems          ActionItem[]
  @@unique([assessmentId, reference])
  @@index([assessmentId, status])
  @@index([productCode])
  @@index([mossControlAssessmentId])
}

model RecommendationRule {
  id                     String          @id @default(cuid())
  questionnaireVersionId String
  code                   String
  title                  String
  category               String
  priority               FindingSeverity
  triggerQuestionId      String?
  triggerMinRisk         Decimal?        @db.Decimal(8, 2)
  summary                String
  serviceOffering        String?
  questionnaireVersion   QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id], onDelete: Cascade)
  triggerQuestion        Question? @relation(fields: [triggerQuestionId], references: [id])
  recommendations        Recommendation[]
  @@unique([questionnaireVersionId, code])
}

model Recommendation {
  id                   String               @id @default(cuid())
  assessmentId         String
  recommendationRuleId String?
  title                String
  category             String
  /// Nullable for MOSS manual recommendations until priority methodology is approved.
  priority             FindingSeverity?
  summary              String
  originalSummary      String?
  suggestedNextStep    String?
  serviceOffering      String?
  responsibleRole      String?
  expectedOutcome      String?
  estimatedEffort      String?
  estimatedCost        Decimal?             @db.Decimal(18, 2)
  expectedBenefit      Decimal?             @db.Decimal(18, 2)
  targetTimeframe      String?
  includeInReport      Boolean              @default(true)
  status               RecommendationStatus @default(GENERATED)
  targetDate           DateTime?
  ownerName            String?
  /// Additive product scope; existing SCLI recommendations remain null (treated as SCLI).
  productCode          ProductCode?
  controlCode          String?
  domainCode           String?
  source               MossRecommendationSource?
  createdById          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  assessment           AssessmentSession @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  recommendationRule   RecommendationRule? @relation(fields: [recommendationRuleId], references: [id])
  createdBy            User? @relation("MossRecommendationAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  actionItems          ActionItem[]
  @@index([assessmentId, status])
  @@index([productCode])
  @@index([controlCode])
}

model QaChecklistItem {
  id           String      @id @default(cuid())
