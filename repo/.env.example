# Database
DATABASE_URL=postgresql://gateway:change-this-database-password@localhost:5432/gateway
DB_SYNCHRONIZE=false

# API
API_PORT=4000
JWT_SECRET=replace-this-secret
AUTH_DISABLED=false
CORS_ORIGIN=http://localhost:8080
STORAGE_ROOT=../../storage
MAX_UPLOAD_MB=100

# Default admin (seeded on startup)
DEFAULT_ADMIN_EMAIL=admin@physicalrisk.com
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# External document connectors
# 32-byte key encoded as 64 hex characters (or any 32+ character secret used as key material).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:8080/api/connectors/google-drive/callback
# Production: https://repo.physicalrisk.com/api/connectors/google-drive/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/api/connectors/google-drive/callback
MCP_ENABLED=true
